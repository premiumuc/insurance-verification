# Copy to .env for local dev. NEVER commit real secrets.
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info

# Comma-separated allowed origins for CORS (mobile/web dev clients)
CORS_ORIGINS=http://localhost:8081,http://localhost:19006

# --- Auth ---
# local = dev/test shim (HS256). Forbidden in production — use cognito there.
AUTH_MODE=local
LOCAL_JWT_SECRET=dev-only-insecure-secret-change-me
SESSION_TTL_SECONDS=3600

# --- Set in staging/prod via AWS Secrets Manager, not here ---
# AUTH_MODE=cognito
# AWS_REGION=us-east-1
# COGNITO_USER_POOL_ID=
# COGNITO_CLIENT_ID=
# DATABASE_URL=
# BEDROCK_MODEL_ID=
# MEDICAL_ENGINE_API_KEY=
