{
  "name": "@healthy-companion/mobile",
  "version": "0.0.0",
  "private": true,
  "description": "Healthy Companion — Expo (React Native) app for iOS, Android, and web.",
  "main": "expo-router/entry",
  "scripts": {
    "dev": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "build": "expo export --platform all",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run --passWithNoTests",
    "clean": "rm -rf dist .expo web-build .turbo"
  },
  "dependencies": {
    "@healthy-companion/safety-rules": "workspace:*",
    "@healthy-companion/types": "workspace:*",
    "@tanstack/react-query": "^5.62.0",
    "expo": "~52.0.0",
    "expo-constants": "~17.0.0",
    "expo-linking": "~7.0.0",
    "expo-local-authentication": "~15.0.0",
    "expo-router": "~4.0.0",
    "expo-secure-store": "~14.0.0",
    "expo-status-bar": "~2.0.0",
    "react": "18.3.1",
    "react-native": "0.76.5",
    "react-native-safe-area-context": "4.12.0",
    "react-native-screens": "~4.4.0",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@types/react": "~18.3.12",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
